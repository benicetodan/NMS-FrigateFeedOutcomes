<Window x:Class="NmsFrigateFeedOutcomes.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Frigate Feed Outcomes" Height="760" Width="1280"
        MinHeight="560" MinWidth="900" Background="#F4F6F2" Foreground="#202521"
        FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="FRIGATE FEED OUTCOMES" FontSize="11" FontWeight="Bold" Foreground="#246B55" />
                <TextBlock Text="Compare living frigate food outcomes" FontSize="23" FontWeight="SemiBold" Margin="0,3,0,0" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="White" BorderBrush="#DCE2DC" BorderThickness="1" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="240" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="OpenSaveButton" Grid.Column="0" Content="Open save..." Padding="16,0" Height="36" MinWidth="120"
                            VerticalAlignment="Bottom" Margin="0,0,14,0" IsEnabled="False" Click="OpenSave_Click" />
                    <StackPanel Grid.Column="1" Margin="0,0,14,0">
                        <TextBlock Text="Living frigate" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5" />
                        <ComboBox x:Name="FrigateSelector" Height="32" VerticalContentAlignment="Center"
                                  DisplayMemberPath="SelectionDisplay" SelectionChanged="Frigate_SelectionChanged" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="ResourceSeed" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5" />
                        <TextBox x:Name="ResourceSeedBox" Height="32" IsReadOnly="True" VerticalContentAlignment="Center" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Current traits" FontSize="12" FontWeight="SemiBold" Foreground="#246B55" Margin="0,0,0,4" />
                        <TextBlock x:Name="CurrentTraitsPlaceholder" Text="Select a frigate to inspect its traits."
                                   Foreground="#66716A" FontSize="12" />
                        <ItemsControl x:Name="CurrentTraitsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="1" Text="{Binding StatBoost}" Foreground="#66716A" FontSize="12" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <Border Grid.Column="1" BorderBrush="#DCE2DC" BorderThickness="1,0,0,0" Padding="16,0,0,0">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <Button x:Name="RecipeReferenceButton" DockPanel.Dock="Right" Content="Open recipe reference"
                                        Height="26" Padding="8,0" IsEnabled="False" Click="RecipeReference_Click"
                                        ToolTip="Open this food's page on No Man's Sky Recipes" />
                                <TextBlock x:Name="SelectedOutcomeHeader" Text="Selected food outcome" FontSize="12"
                                           FontWeight="SemiBold" Foreground="#246B55" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock x:Name="SelectedTraitsPlaceholder" Text="Select a food row to inspect its traits."
                                       Foreground="#66716A" FontSize="12" />
                            <ItemsControl x:Name="SelectedTraitsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="190" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="1" Text="{Binding StatBoost}" Foreground="#66716A" FontSize="12" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <TextBox x:Name="FilterBox" DockPanel.Dock="Right" Width="260" Height="30" Padding="8,4"
                         VerticalContentAlignment="Center" ToolTip="Filter by food or trait name/ID, or stat total"
                         TextChanged="Filter_TextChanged" />
                <TextBlock x:Name="ResultsCount" VerticalAlignment="Center" Foreground="#66716A" />
            </DockPanel>
            <DataGrid x:Name="ResultsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserSortColumns="True" CanUserResizeRows="False"
                      GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowHeight="34"
                      Background="White" BorderBrush="#DCE2DC"
                      BorderThickness="1" SelectionMode="Single" SelectionUnit="FullRow"
                      EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                      SelectionChanged="ResultsGrid_SelectionChanged">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBestAtAnyModifier}" Value="True">
                                <Setter Property="Background" Value="#FFF0C2" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsBestOverall}" Value="True">
                                <Setter Property="Background" Value="#CDE8D6" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Food item" Binding="{Binding FoodName}" SortMemberPath="FoodName" Width="220" />
                    <DataGridTextColumn Header="Predicted traits" Binding="{Binding LocalizedTraits}" SortMemberPath="LocalizedTraits" Width="300" />
                    <DataGridTextColumn Header="Combat" Binding="{Binding Combat, StringFormat={}{0:+#;-#;0}}" SortMemberPath="Combat" Width="80" />
                    <DataGridTextColumn Header="Trading" Binding="{Binding Trading, StringFormat={}{0:+#;-#;0}}" SortMemberPath="Trading" Width="80" />
                    <DataGridTextColumn Header="Exploration" Binding="{Binding Exploration, StringFormat={}{0:+#;-#;0}}" SortMemberPath="Exploration" Width="95" />
                    <DataGridTextColumn Header="Mining" Binding="{Binding Mining, StringFormat={}{0:+#;-#;0}}" SortMemberPath="Mining" Width="80" />
                    <DataGridTextColumn Header="Expedition Duration" Binding="{Binding ExpeditionDuration, StringFormat={}{0:+#;-#;0}%}" SortMemberPath="ExpeditionDuration" Width="125" />
                    <DataGridTextColumn Header="Expedition Fuel Cost" Binding="{Binding ExpeditionFuelCost, StringFormat={}{0:+#;-#;0}}" SortMemberPath="ExpeditionFuelCost" Width="135" />
                    <DataGridTextColumn Header="Overall score" Binding="{Binding OverallScore, StringFormat={}{0:+#;-#;0}}" SortMemberPath="OverallScore" Width="105" />
                    <DataGridTextColumn Header="Best at" Binding="{Binding BestAt}" SortMemberPath="BestAt" Width="220" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Border Background="#FFF0C2" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,5,0" />
                <TextBlock Text="Best by stat" Foreground="#66716A" VerticalAlignment="Center" Margin="0,0,16,0" />
                <Border Background="#CDE8D6" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,5,0" />
                <TextBlock Text="Best overall" Foreground="#66716A" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="StatusText" Foreground="#66716A" TextWrapping="Wrap" />
        </DockPanel>
    </Grid>
</Window>